  <diagram name="Alur Penilaian dan Pelaporan">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s1" value="MULAI&#xa;Kegiatan &amp; peserta siap" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="820" y="40" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Admin / Bidang Kader&#xa;Susun rubrik per tahap, jenis penilaian, dan materi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="160" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Bobot aspek &amp; indikator = 100&#37;,&#xa;uraian skor 1-5 lengkap?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="830" y="300" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="x1" value="Tidak: perbaiki draf rubrik,&#xa;lalu coba aktifkan lagi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1360" y="315" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Aktifkan versi baru&#xa;(versi lama diarsipkan, hasil lama tidak berubah)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="460" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Tugaskan Observer &amp; Instruktur&#xa;ke kegiatan (penugasan di basis data)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="600" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Observasi: isi skor 1-5 atau N/O,&#xa;bukti, dan catatan per penulis&#xa;(nilai tiap penilai independen)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="740" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Autosave ±700 ms &amp; draf lokal; Realtime&#xa;menampilkan perubahan penilai lain" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="900" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Revisi data lokal&#xa;sama dengan server?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="830" y="1040" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="Konflik: pilih data terbaru&#xa;atau terapkan ulang draf&#xa;dengan revisi server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1055" width="420" height="90" as="geometry" />
