<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="26.0.0">
  <diagram name="Aturan Perhitungan Skor">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="i1" value="Skor Observer / Instruktur&#xa;bilangan bulat 1-5&#xa;1 Sangat Kurang · 2 Kurang · 3 Cukup&#xa;4 Baik · 5 Sangat Baik" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="40" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="N/O = Belum diamati&#xa;Tidak diberi skor dan TIDAK dihitung sebagai 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1320" y="40" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="Belum submit = pending&#xa;Tidak ikut agregasi (draft tidak dihitung)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1320" y="150" width="520" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Saring data: hanya rating dari submission berstatus Submitted / Finalized" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="190" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Rata-rata tiap indikator = jumlah skor sah dibagi jumlah penilai sah&#xa;Skor minimum, maksimum, rentang, jumlah N/O, dan pending tetap ditampilkan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="320" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Nilai aspek (skala 1-5)&#xa;= Σ(rata-rata indikator × bobot indikator) ÷ Σ(bobot indikator yang valid)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="480" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Penyesuaian N/O:&#xa;bila sebagian indikator N/O, bobot yang tersisa&#xa;dinormalisasi ke 100&#37; untuk aspek itu.&#xa;Bila semua indikator N/O, aspek dikeluarkan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="320" width="520" height="140" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="Coverage tiap aspek ≥ 80&#37;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="740" y="630" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Tidak: aspek tidak valid,&#xa;hasil ditandai provisional,&#xa;belum boleh difinalisasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1320" y="630" width="520" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="Nilai keseluruhan = Σ(nilai aspek ÷ 5 × bobot aspek)&#xa;Syarat: total bobot aspek harus 100&#37;.&#xa;Bobot aspek TIDAK dinormalisasi ulang." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="780" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Rentang skor antar penilai ≥ 2?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="740" y="940" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Ya: moderator menetapkan&#xa;retain_average atau consensus.&#xa;Rating Observer tidak ditimpa;&#xa;status harus reviewed / resolved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1320" y="940" width="520" height="120" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="Ubah ke skala 0-100&#xa;Snapshot / evaluasi kolektif: (nilai ÷ 5) × 100 per aspek&#xa;Dashboard lama: (rata-rata − 1) ÷ 4 × 100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="1090" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Kategori: 0 - &lt;60 Perlu pengembangan | 60 - &lt;75 Cukup |&#xa;75 - &lt;90 Baik | 90 - 100 Sangat baik" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="1250" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Keputusan lulus / perlu pembahasan lanjutan&#xa;DITETAPKAN MANUAL oleh koordinator, bukan aturan otomatis.&#xa;Rekomendasi otomatis (indikator rata-rata &lt;3/5) hanya draf, harus disetujui." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="1390" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Finalisasi → snapshot immutable → publikasi rapor → ekspor (semua tercatat di audit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="1560" width="560" height="100" as="geometry" />
        </mxCell>

